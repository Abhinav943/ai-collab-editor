{
  "name": "ai-collab-editor",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"CLIENT,SERVER\" -c \"cyan,magenta\" \"npm run client\" \"npm run server\"",
    "client": "npm run dev -w client",
    "server": "npm run dev -w server",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "judge0:up": "docker compose -f docker-compose.judge0.yml up -d",
    "judge0:down": "docker compose -f docker-compose.judge0.yml down",
    "judge0:check": "node scripts/check-judge0.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
